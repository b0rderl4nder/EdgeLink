{
  "device_name": "edge-device",
  "tick_seconds": 15,
  "wifi": {
    "interface": "wlan0",
    "startup_grace_seconds": 45,
    "reconnect_interval_seconds": 15,
    "reconnect_settle_seconds": 12,
    "reconnect_attempts_before_ap": 3,
    "ap_fallback_seconds": 60,
    "recovery_cooldown_seconds": 120,
    "ap_restore_retry_seconds": 3,
    "provisioning_start_delay_seconds": 1,
    "auto_retry_saved_profiles": true,
    "ap_saved_retry_seconds": 180,
    "ap_client_hold_seconds": 120,
    "checkpoint_timeout_seconds": 90
  },
  "access_point": {
    "enabled": true,
    "connection_name": "edgelink-provisioning",
    "ssid": "",
    "ssid_prefix": "EdgeLink",
    "password_env": "EDGELINK_AP_PASSWORD",
    "ipv4_cidr": "10.42.0.1/24",
    "reserved_connection_names": []
  },
  "health": {
    "dns_name": "example.com",
    "dns_timeout_seconds": 2,
    "target_policy": "any",
    "minimum_connectivity": "internet",
    "accept_dns_as_internet_evidence": true,
    "targets": [
      {
        "name": "public_https",
        "host": "1.1.1.1",
        "port": 443,
        "required": true,
        "timeout_seconds": 1.5
      }
    ]
  },
  "overlay": {
    "enabled": true,
    "kind": "easytier",
    "service_unit": "easytier@default.service",
    "cli_path": "/usr/sbin/easytier-cli",
    "expected_cidr_prefix": "192.167.",
    "disconnected_restart_seconds": 20
  },
  "api": {
    "listen_host": "0.0.0.0",
    "listen_port": 8787,
    "trusted_mutation_subnets": [
      "127.0.0.0/8",
      "10.42.0.0/24"
    ]
  }
}
